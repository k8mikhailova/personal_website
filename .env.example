# Copy to .env.local for local development (.env.local is gitignored).
# In Vercel, set these under Project → Settings → Environment Variables.

# Required. Server-side only; never prefix with VITE_.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5-mini.
OPENAI_MODEL=gpt-5-mini

# Optional. Reasoning effort for GPT-5-family models (default: minimal).
# OPENAI_REASONING_EFFORT=minimal

# Optional. Extra comma-separated origins allowed to call /api/chat
# (same-origin requests are always allowed).
# CHAT_ALLOWED_ORIGINS=
